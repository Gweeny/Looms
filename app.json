{
  "expo": {
    "name": "Looms",
    "slug": "Looms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gweeny.Looms"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a2caf359-cb68-4f4a-86d1-5be6d5d8c5c0"
      }
    },
    "owner": "gweeny",
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Looms a besoin de la caméra pour prendre des photos."
        }
      ],
      "expo-image-picker",
      "expo-task-manager"
    ]
  }
}
